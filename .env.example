# Required for AI script generation. Keep this secret on the backend only.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: enables YouTube mostPopular videos as an additional public signal.
YOUTUBE_API_KEY=

# Comma-separated frontend origins. During initial setup, * is easiest.
# After deployment, replace * with your frontend URL, e.g. https://trendradar.onrender.com
CORS_ORIGINS=*

CACHE_TTL_SECONDS=900
REQUEST_TIMEOUT_SECONDS=12
LOG_LEVEL=INFO
